@model Adega.Models.Cliente

<h2 class="text-white mb-4">✏️ Editar Cliente</h2>

<form method="post" class="bg-dark text-white p-4 rounded shadow-sm">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome</label>
        <input asp-for="Nome" class="form-control" />
        <span asp-validation-for="Nome" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Telefone" class="form-label">Telefone</label>
        <input asp-for="Telefone" class="form-control" />
        <span asp-validation-for="Telefone" class="text-danger"></span>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <button type="submit" class="btn btn-success">💾 Salvar</button>

        <a href="javascript:history.back()" class="btn btn-secondary">
            ⬅️ Voltar
        </a>
    </div>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <script>
        $(document).ready(function () {
            $('input[name="Telefone"]').mask('(00) 00000-0000');
        });
    </script>
}
