<html>
<head>
    <meta charset="utf-8" />
    <title>Adega Sintonia</title>

    <!-- Bootstrap CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.mask/1.14.16/jquery.mask.min.js"></script>
    <link href="~/css/site.css" rel="stylesheet" />
</head>
<body>

    @{
        var config = Context.RequestServices.GetService<Adega.Data.AppDbContext>()
        .ConfiguracoesSistema.FirstOrDefault();
    }

    @if (ViewBag.DiasRestantes != null && ViewBag.DiasRestantes <= 30)
    {
        var cor = (int)ViewBag.DiasRestantes <= 5 ? "red" : "orange";
        <div style="background-color:@cor; color:white; padding:10px; text-align:center;">
            🔔 Sua licença expira em <strong>@ViewBag.DiasRestantes dias</strong>.<br />
            Entre em contato com o suporte:
            <a href="mailto:@ViewBag.SuporteEmail" style="color:white; text-decoration:underline;">@ViewBag.SuporteEmail</a> |
            <a href="tel:@ViewBag.SuporteTelefone" style="color:white; text-decoration:underline;">@ViewBag.SuporteTelefone</a>
        </div>
    }
    @{
        var path = Context.Request.Path.Value?.ToLower() ?? "";
        var ocultarMenu = path.Contains("/login") || path.Contains("/licenca/expirada") ;
    }

    @if (!ocultarMenu)
    {
        <nav class="navbar navbar-expand-lg navbar-dark bg-secondary shadow-sm px-4">


            <div class="container-fluid">
                <span class="navbar-brand d-flex align-items-center">
                    <img src="~/Imagens/iconeCaneca.png" asp-append-version="true" alt="Ícone" style="width:30px; height:30px;" />
                    Bem-vindo, @Context.Session.GetString("UsuarioNome")!
                </span>


                <div class="collapse navbar-collapse justify-content-center" id="navbarNav">
                    <ul class="navbar-nav">
                        <li class="nav-item"><a class="nav-link" href="/VendaDireta/Index">🛒 Vendas Diretas</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Categoria/Index">🍱 Categorias</a></li>                       
                        <li class="nav-item"><a class="nav-link" href="/Combo/Index">🍻 Combos</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Cliente/Index">👥 Clientes</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Comanda/Index">🧾 Comandas</a></li>
                        <li class="nav-item"><a class="nav-link" href="/Pedido/Index">📞 Pedidos</a></li>

                        @if (Context.Session.GetString("UsuarioTipo") == "Admin")
                        {
                            <li class="nav-item"><a class="nav-link" href="/Produto/Gerenciar">📦 Produtos</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Relatorio/Index">📊 Relatórios</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Usuario/Index">🧑‍💼 Usuários</a></li>
                            <li class="nav-item"><a class="nav-link" href="/Promocao/Index">🎁 Promoções</a></li>

                        }
                    </ul>
                </div>

                <div class="d-flex">
                    <a class="nav-link text-danger fw-bold" href="/Login/Sair">🚪Sair</a>
                    @RenderSection("Scripts", required: false)
                </div>
            </div>
        </nav>
    }

    <div class="container container-principal mt-4">
        @RenderBody()

        @if (ViewBag.DiasRestantes != null && ViewBag.DiasRestantes <= 5)
        {
            <div id="modalAlerta" class="modal" style="display:block; position:fixed; z-index:9999; background-color: rgba(0,0,0,0.6); top:0; left:0; width:100%; height:100%;">
                <div style="background:white; width:400px; margin:100px auto; padding:20px; border-radius:10px; text-align:center;">
                    <h4>⚠️ Atenção</h4>
                    <p>Sua licença expira em <strong>@ViewBag.DiasRestantes</strong> dias.</p>
                    <p>Entre em contato com <a href="mailto:@ViewBag.SuporteEmail">@ViewBag.SuporteEmail</a></p>
                    <button onclick="document.getElementById('modalAlerta').style.display='none'">Fechar</button>
                </div>
            </div>
        }

    </div>
