@model List<Adega.Models.Categoria>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger text-center fw-bold">
        @TempData["Erro"]
    </div>
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-white">📁 Categorias</h2>
    <a href="/Categoria/Criar" class="btn btn-success">➕ Nova Categoria</a>
</div>

<table class="table table-dark table-hover table-bordered shadow-sm">
    <thead class="table-secondary text-dark">
        <tr>
            <th>Nome</th>
            <th class="text-center">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Nome</td>
                <td class="text-center">
                    <a href="/Categoria/Editar/@c.Id" class="btn btn-sm btn-outline-primary me-2">✏️ Editar</a>
                    <a href="/Categoria/Excluir/@c.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Deseja excluir?')">🗑️ Excluir</a>
                </td>
            </tr>
        }
    </tbody>

    <nav class="mt-4">
    <tfoot>
        <tr>
            <td colspan="6" class="text-center bg-dark">
                <nav class="mt-3">
                    <ul class="pagination justify-content-center mb-0">
                            @for (int i = 1; i <= (int)ViewBag.TotalPaginas; i++)
                            {
                            <li class="page-item @(i == (int)ViewBag.PaginaAtual ? "active" : "")">
                                <a class="page-link" href="@Url.Action("Index", new { page = i, buscaNome = ViewBag.BuscaNome, categoriaId = ViewBag.CategoriaId })">
                                        @i
                                </a>
                            </li>
                            }
                    </ul>
                </nav>
            </td>
        </tr>
    </tfoot>

    </nav>
</table>

