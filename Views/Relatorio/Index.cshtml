@model List<Adega.Models.MovimentacaoFinanceira>
@{
    ViewData["Title"] = "Relatório Financeiro";
    var dataSelecionada = (DateTime)ViewBag.Data;
    var entrada = (decimal)ViewBag.EntradaTotal;
    var saida = (decimal)ViewBag.SaidaTotal;
    var saldo = (decimal)ViewBag.Saldo;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2 class="text-white">📊 Relatório Financeiro: @dataSelecionada.ToString("dd-MM-yyyy")</h2>
</div>

<div class="card bg-dark text-white p-4 shadow mb-4">
    <form method="get" class="row g-3 align-items-end">
        <div class="col-md-3">
            <label class="form-label">Data:</label>
            <input type="date" name="data" class="form-control"
                   value="@((DateTime)ViewBag.Data).ToString(" yyyy-MM-dd")" />
        </div>

        <div class="col-md-3">
            <label class="form-label">Tipo:</label>
            <select name="tipo" class="form-select">
                @foreach (var opt in new[] { "", "entrada", "saida" })
                {
                    var texto = opt == "" ? "Todas" : opt == "entrada" ? "Entradas" : "Saídas";
                    <option value="@opt" selected="@(ViewBag.Tipo == opt ? "selected" : null)">@texto</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <label class="form-label">Período:</label>
            <select name="periodo" class="form-select">
                @foreach (var p in new[] { "", "hoje", "semana", "mes" })
                {
                    var texto = p == "" ? "Data Exata" :
                    p == "hoje" ? "Hoje" :
                    p == "semana" ? "Últimos 7 Dias" : "Este Mês";

                    <option value="@p" selected="@(ViewBag.Periodo == p ? "selected" : null)">@texto</option>
                }
            </select>
        </div>

        <div class="col-md-3">
            <button type="submit" class="btn btn-success w-100">🔍 Buscar</button>
        </div>
    </form>
</div>

<div class="table-responsive">
    <table class="table table-bordered table-striped table-dark shadow-sm">
        <thead class="table-secondary text-dark">
            <tr>
                <th>Data</th>
                <th>Descrição</th>
                <th>Entrada</th>
                <th>Saída</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var m in Model)
            {
                <tr>
                    <td>@m.Data.ToString("dd/MM/yyyy HH:mm")</td>
                    <td>@m.Descricao</td>
                    <td class="text-success">R$ @m.Entrada.ToString("F2")</td>
                    <td class="text-danger">R$ @m.Saida.ToString("F2")</td>
                </tr>
            }
        </tbody>
    </table>
    <nav class="mt-4">
        <ul class="pagination justify-content-center mb-0">
            @for (int i = 1; i <= (int)ViewBag.TotalPaginas; i++)
            {
                <li class="page-item @(i == (int)ViewBag.PaginaAtual ? "active" : "")">
                    <a class="page-link"
                       href="@Url.Action("Index", new { data = ViewBag.Data?.ToString("yyyy-MM-dd"), tipo = ViewBag.Tipo, periodo = ViewBag.Periodo, page = i })">
                        @i
                    </a>
                </li>
            }
        </ul>
    </nav>

</div>

<div class="p-4 rounded text-white mt-4" style="background-color: rgba(0, 0, 0, 0.7);">
    <p><strong>Total de Entrada:</strong> <span style="color:limegreen;">R$ @entrada.ToString("F2")</span></p>
    <p><strong>Total de Saída:</strong> <span style="color:crimson;">R$ @saida.ToString("F2")</span></p>
    <p><strong>Saldo do Dia:</strong> <span style="color:aqua;" class="fw-bold">R$ @saldo.ToString("F2")</span></p>
</div>

