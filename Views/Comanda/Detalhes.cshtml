@model Adega.Models.Comanda

@{
    ViewData["Title"] = "Detalhes da Comanda";
    var total = Model.Itens?.Sum(i => i.Quantidade * i.PrecoUnitario) ?? 0;
}

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger text-center">@TempData["Erro"]</div>
}

<div class="card bg-dark text-white p-4 shadow">
    <h2>🧾 COMANDA: @Model.Id - @Model.Cliente?.Nome.ToUpper()</h2>
    <p><strong>Status:</strong> @Model.Status.ToUpper()</p>
    <p><strong>Data:</strong> @Model.DataAbertura</p>

    <hr />

    <h4>Itens da Comanda</h4>

    @if (Model.Itens != null && Model.Itens.Any())
    {
        <div class="table-responsive">
            <table class="table table-dark table-bordered table-striped">
                <thead class="table-secondary text-dark">
                    <tr>
                        <th>Produto</th>
                        <th>Qtd</th>
                        <th>Unitário</th>
                        <th>Total</th>
                        <th>Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.Itens)
                    {
                        <tr id="linha-@item.Id">
                            <form method="post" asp-action="AtualizarItem">
                                <input type="hidden" name="itemId" value="@item.Id" />

                            <td><input type="text" class="form-control-plaintext text-white" readonly value="@item.Produto?.Nome" /></td>
                            <td><input type="number" class="form-control" name="quantidade" id="qtd-@item.Id" value="@item.Quantidade" disabled style="width: 80px;" /></td>
                            <td><input type="text" class="form-control-plaintext text-white" readonly value="@item.PrecoUnitario.ToString("F2")" /></td>
                            <td>R$ @((item.Quantidade * item.PrecoUnitario).ToString("F2"))</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-warning" onclick="habilitarEdicao(@item.Id)">✏️ Alterar</button>
                                <button type="submit" class="btn btn-sm btn-outline-success" id="btn-salvar-@item.Id" style="display:none;">💾 Salvar</button>
                                <a href="/Comanda/RemoverItem/@item.Id" class="btn btn-sm btn-outline-danger" onclick="return confirm('Remover item?')">🗑️ Excluir</a>
                            </td>
                            </form>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <p>Nenhum item adicionado.</p>
    }

    <div class="mt-3 bg-secondary text-white p-3 rounded">
        <strong>TOTAL DA COMANDA:</strong> R$ @total.ToString("F2")
    </div>

    @if (Model.Status != "Fechada")
    {
        <hr />
        <h4>Adicionar Produto ou Combo</h4>
        <form method="post" asp-action="AdicionarItem" onsubmit="return validarEstoque()" class="row g-3 align-items-end">
            <input type="hidden" name="comandaId" value="@Model.Id" />

            <div class="col-md-5">
                <label class="form-label">Produto:</label>
                <select id="produtoId" name="produtoId" class="form-select">
                    <option value="">-- Nenhum --</option>
                    @foreach (var p in (List<Adega.Models.Produto>)ViewBag.Produtos)
                    {
                        <option value="@p.Id" data-estoque="@p.QuantidadeEstoque">@p.Nome</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Qtd:</label>
                <input type="number" id="quantidadeProduto" name="quantidadeProduto" class="form-control" min="1" value="1" />
            </div>

            <div class="col-md-3">
                <label class="form-label">Combo:</label>
                <select name="comboId" class="form-select">
                    <option value="">-- Nenhum --</option>
                    @foreach (var c in (List<Adega.Models.Produto>)ViewBag.Combos)
                    {
                        <option value="@c.Id">COMBO: @c.Nome</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <label class="form-label">Qtd Combo:</label>
                <input type="number" name="quantidadeCombo" class="form-control" min="1" value="1" />
            </div>

            <!-- LINHA DE BOTÕES (dentro de qualquer <form> ou fora) -->
            <div class="row mt-4 g-2">
                <!-- Adicionar Produto/Combo -->
                <div class="col-md-4 text-start">
                    <form method="post" asp-action="AdicionarItem" onsubmit="return validarEstoque()">
                        <input type="hidden" name="comandaId" value="@Model.Id" />
                        <button type="submit" class="btn btn-success w-100">➕ Adicionar</button>
                    </form>
                </div>

                <!-- Fechar Comanda -->
                <div class="col-md-4 text-center">
                    <form method="post" asp-action="Fechar" asp-route-id="@Model.Id">
                        <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Deseja realmente fechar esta comanda?')">
                            🚫 Fechar Comanda
                        </button>
                    </form>
                </div>

                <!-- Voltar -->
                <div class="col-md-4 text-end">
                    <a href="javascript:history.back()" class="btn btn-secondary w-100">⬅️ Voltar</a>
                </div>
            </div>

        </form>
        <nav class="mt-4">
            <tfoot>
                <tr>
                    <td colspan="6" class="text-center bg-dark">
                        <nav class="mt-3">
                            @if (ViewBag.TotalPaginas != null && ViewBag.PaginaAtual != null)
                            {
                                <ul class="pagination justify-content-center mb-0">
                                    @for (int i = 1; i <= (int)ViewBag.TotalPaginas; i++)
                                    {
                                        <li class="page-item @(i == (int)ViewBag.PaginaAtual ? "active" : "")">
                                            <a class="page-link" href="@Url.Action("Index", new { page = i })">@i</a>
                                        </li>
                                    }
                                </ul>
                            }

                        </nav>
                    </td>
                </tr>
            </tfoot>

        </nav>


    }
    else
    {
        <div class="alert alert-success mt-4 text-center">Comanda Fechada ✅</div>
    }
</div>

@section Scripts {
    <script>
        function validarEstoque() {
            const select = document.getElementById("produtoId");
            const selected = select.options[select.selectedIndex];
            const quantidade = parseInt(document.getElementById("quantidadeProduto").value);
            const estoque = parseInt(selected.getAttribute("data-estoque"));

            if (!isNaN(estoque) && quantidade > estoque) {
                alert("Estoque insuficiente para esse produto. Disponível: " + estoque);
                return false;
            }
            return true;
        }

        function habilitarEdicao(id) {
            document.getElementById('qtd-' + id).removeAttribute('disabled');
            document.getElementById('btn-salvar-' + id).style.display = 'inline';
        }
    </script>
}
