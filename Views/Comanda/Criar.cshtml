@{
    ViewData["Title"] = "Nova Comanda";
}

<div class="card p-4 bg-dark text-white shadow">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>📝 Nova Comanda</h2>
    </div>

    <form method="post">
        <div class="mb-3">
            <label class="form-label">Cliente:</label>
            <select name="clienteId" class="form-select" required>
                <option value="">-- Selecione --</option>
                @foreach (var cliente in (List<Adega.Models.Cliente>)ViewBag.Clientes)
                {
                    <option value="@cliente.Id">@cliente.Nome</option>
                }
            </select>
        </div>

        <div class="d-flex justify-content-between mt-4">
            <button type="submit" class="btn btn-success">➕ Criar Comanda</button>

            <a href="javascript:history.back()" class="btn btn-secondary">
                ⬅️ Voltar
            </a>
        </div>     
    </form>
</div>
