@model Adega.Models.Usuario

<h2 class="text-white mb-4">@(ViewData["Title"] ?? "Usuário")</h2>

<form method="post" class="bg-dark text-white p-4 rounded shadow-sm">
    <div class="mb-3">
        <label asp-for="Nome" class="form-label">Nome:</label>
        <input asp-for="Nome" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="Senha" class="form-label">Senha:</label>
        <input asp-for="Senha" type="password" class="form-control" required />
    </div>

    <div class="mb-3">
        <label asp-for="TipoUsuario" class="form-label">Tipo:</label>
        <select asp-for="TipoUsuario" class="form-select">
            <option value="Admin">Admin</option>
            <option value="Usuario">Usuário</option>
        </select>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <button type="submit" class="btn btn-success">💾 Salvar</button>

        <a href="javascript:history.back()" class="btn btn-secondary">
            ⬅️ Voltar
        </a>
    </div>
</form>
