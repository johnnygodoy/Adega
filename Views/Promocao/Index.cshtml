@model List<Adega.Models.Promocao>

@{
    ViewBag.Title = "Promoções";
}

<h2 class="text-white">🎁 Promoções</h2>

@if (TempData["Erro"] != null)
{
    <div class="alert alert-danger fw-bold">@TempData["Erro"]</div>
}
@if (TempData["Sucesso"] != null)
{
    <div class="alert alert-success fw-bold">@TempData["Sucesso"]</div>
}

<form method="post" asp-action="Cadastrar" class="row g-2 mb-4">
    <div class="col-md-4">
        <input type="text" name="titulo" class="form-control" placeholder="Título da promoção" required />
    </div>
    <div class="col-md-6">
        <input type="text" name="descricao" class="form-control" placeholder="Descrição" required />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-success w-100">💾 Salvar</button>
    </div>
</form>

<table class="table table-dark table-striped table-bordered shadow-sm">
    <thead class="table-secondary text-dark">
        <tr>
            <th>Título</th>
            <th>Descrição</th>
            <th>Status</th>
            <th>Data</th>
            <th class="text-center">Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td>@p.Titulo</td>
                <td>@p.Descricao</td>
                <td>@(p.Ativa ? "✅ Ativa" : "🚫 Inativa")</td>
                <td>@p.CriadaEm.ToString("dd/MM/yyyy")</td>
                <td class="text-center">
                    <a href="/Promocao/AlternarStatus/@p.Id" class="btn btn-sm btn-warning">🔁 Ativar/Inativar</a>
                    <a href="/Promocao/Excluir/@p.Id" class="btn btn-sm btn-danger">🗑️ Excluir</a>
                </td>
            </tr>
        }
    </tbody>
</table>
